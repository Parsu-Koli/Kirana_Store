@model KiranaStoreUI.Models.Sale

<style>
    /* RECEIPT BOX CENTERED */
    #receiptContainer {
        width: 100%;
        max-width: 380px;
        margin: 40px auto; /* CENTER BOX */
        font-family: "Courier New", monospace;
        background: #ffffff;
        padding: 15px;
        border: 1px dashed #999;
        border-radius: 8px;
        text-align: left; /* INNER CONTENT LEFT */
        box-sizing: border-box;
    }

        #receiptContainer h2,
        #receiptContainer h4 {
            font-weight: bold;
            text-align: center;
            width: 100%;
        }

    .receipt-header {
        text-align: center;
        border-bottom: 1px dashed #999;
        padding-bottom: 10px;
        margin-bottom: 12px;
    }

    .receipt-footer {
        border-top: 1px dashed #999;
        padding-top: 10px;
        margin-top: 10px;
        text-align: center;
        font-size: 12px;
        color: #555;
    }

    /* ✅ WRAP TABLE SO EXTRA GST COLUMNS DON'T BREAK LAYOUT ON NARROW PHONES */
    .receipt-table-wrap {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    table.receipt-table {
        width: 100%;
        min-width: 320px;
        text-align: center;
        border-collapse: collapse;
    }

        table.receipt-table th,
        table.receipt-table td {
            font-size: 13px;
            padding: 4px 3px;
            text-align: center;
            word-break: break-word;
        }

    .total-row {
        font-weight: bold;
        border-top: 1px dashed #999;
    }

    /* PRINT OPTIMIZATION */
    @@media print {
        body * {
            visibility: hidden;
        }

        .no-print {
            display: none !important;
        }


        #receiptContainer,
        #receiptContainer * {
            visibility: visible;
        }

        #receiptContainer {
            display: block !important;
            width: 150%;
            margin: 0 auto;
            border: 1px dashed #000 !important;
            transform: scale(1.67); /* ZOOM FIT */
            transform-origin: top center;
        }

        * {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
    }

    /* ============================
       RESPONSIVE (SCREEN ONLY)
       ============================ */
    @@media (max-width: 480px) {
        #receiptContainer {
            margin: 16px auto;
            padding: 12px;
            border-radius: 6px;
        }

        #receiptContainer h2 {
            font-size: 18px;
        }

        #receiptContainer h4 {
            font-size: 15px;
        }

        table.receipt-table th,
        table.receipt-table td {
            font-size: 11px;
            padding: 3px 2px;
        }

        .receipt-footer {
            font-size: 11px;
        }

        div[style*="font-size:18px"] {
            font-size: 15px !important;
        }
    }

    @@media (max-width: 360px) {
        table.receipt-table {
            min-width: 280px;
        }
    }
</style>

<div id="receiptContainer">

    <!-- HEADER -->
    <div class="receipt-header">
        <h2>🛒 Kirana Store Receipt</h2>
        <div><strong>Invoice:</strong> @Model.InvoiceNumber</div>
        <div><strong>Date:</strong> @Model.SaleDate.ToString("dd-MMM-yyyy HH:mm")</div>
    </div>


    <!-- ITEMS -->
    <h4 class="mt-3">📦 Purchased Items</h4>

    @if (Model.SaleItems != null && Model.SaleItems.Any())
    {
        <div class="receipt-table-wrap">
            <table class="receipt-table">
                <thead>
                    <tr>
                       <th>#</th>
    <th>Item</th>
    <th>Qty</th>
    <th>Rate</th>
    <th>Total</th>

    @if (Model.TotalGST > 0)
    {
        <th>GST %</th>
        <th>GST Amt</th>
    }
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.SaleItems.Count; i++)
                    {
                        var item = Model.SaleItems[i];
                        <tr>
                            <td>@(i + 1)</td>
    <td>@item.Product?.ProductName</td>
    <td>@item.Quantity</td>
    <td>₹@item.Price</td>
    <td>₹@item.Total</td>

    @if (Model.TotalGST > 0)
    {
        <td>@item.GstPercentage %</td>
        <td>₹@item.GstAmount</td>
    }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center">No items found.</div>
    }
    <!-- PAYMENT INFO -->
<h4>💳 Payment Info</h4>

<div><strong>Mode:</strong> @Model.PaymentMode</div>

<div><strong>Sub Total:</strong> ₹@Model.TotalAmount</div>

@if (Model.TotalGST > 0)
{
    <div><strong>CGST:</strong> ₹@Model.CGST</div>

    <div><strong>SGST:</strong> ₹@Model.SGST</div>

    <div><strong>Total GST:</strong> ₹@Model.TotalGST</div>
}

<div><strong>Discount:</strong> ₹@Model.Discount</div>

<hr />

<div style="font-size:18px;font-weight:bold;">
    Net Amount : ₹@Model.NetAmount
</div>



    <!-- FOOTER -->
    <div class="receipt-footer">
        Thank you for shopping!
        <br />📱 Call: 9322703402
        <br />🏪 Visit Again
    </div>

    <!-- BUTTONS -->
    <div class="mt-3 d-flex justify-content-center gap-3 no-print flex-wrap">
        <a href="/Sale/Index" class="btn btn-secondary btn-sm">Back</a>
        <button type="button" class="btn btn-primary btn-sm" onclick="printSale()">Print 🖨️</button>
    </div>

</div>

<script>
    function printSale() {
        window.print();
    }
</script>
