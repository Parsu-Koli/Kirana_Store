@model KiranaStoreUI.Models.ViewModels.SaleCustomerVM

@{
    ViewData["Title"] = "Edit Sale";
}

<div class="container-fluid px-3 px-md-4 mt-4">

    <h2 class="page-title text-warning">
        ✏️ Edit Sale &amp; Customer
    </h2>

    <div class="glass-card">
        <div class="p-3 p-md-4">

            <form asp-action="Edit" method="post" id="saleForm">

                <!-- Hidden Keys -->
                <input asp-for="Sale.SaleId" type="hidden" />
                <input asp-for="Customer.CustomerId" type="hidden" />

                <div asp-validation-summary="All" class="alert alert-danger"></div>

                <div class="row g-3">

                    <!-- SALE DETAILS -->
                    <div class="col-12 col-md-6">
                        <h4 class="text-primary mb-3">Sale Details</h4>

                        <div class="mb-3">
                            <label class="fw-bold">Invoice Number</label>
                            <input asp-for="Sale.InvoiceNumber"
                                   class="form-control fw-bold"
                                   readonly />
                        </div>

                        <div class="mb-3">
                            <label class="fw-bold">Payment Mode</label>
                            <select asp-for="Sale.PaymentMode" class="form-select">
                                <option value="Cash">Cash</option>
                                <option value="UPI">UPI</option>
                                <option value="Card">Card</option>
                                <option value="Udari">Udari</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="fw-bold">Sale Date</label>
                            <input asp-for="Sale.SaleDate"
                                   type="date"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label>Total Amount</label>
                            <input asp-for="Sale.TotalAmount"
                                   class="form-control text-end fw-bold"
                                   readonly />
                        </div>

                        <div class="mb-3">
                            <label>Discount</label>
                            <input asp-for="Sale.Discount"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control text-end" />
                        </div>

                        <div class="mb-3">
                            <label>Net Amount</label>
                            <input asp-for="Sale.NetAmount"
                                   class="form-control text-end fw-bold text-success"
                                   readonly />
                        </div>
                    </div>


                    <!-- CUSTOMER DETAILS -->
                    <div class="col-12 col-md-6">
                        <div class="glass-section">
                            <h4 class="text-primary mb-3">Customer Details</h4>
                            <input type="hidden" asp-for="Sale.CustomerId" />

                            <div class="mb-3">
                                <label class="fw-bold">Customer Name</label>
                                <input asp-for="Customer.Name"
                                       class="form-control"
                                       required />
                            </div>

                            <div class="mb-3">
                                <label class="fw-bold">Phone</label>
                                <input asp-for="Customer.Phone"
                                       class="form-control"
                                       required />
                            </div>
                        </div>
                    </div>
                </div>

                <hr />

                <!-- SALE ITEMS -->
                <h5 class="fw-bold mb-3">Sale Items</h5>

                <!-- ✅ TABLE WRAPPED FOR HORIZONTAL SCROLL ON SMALL SCREENS -->
                <div class="table-responsive sale-items-wrap">
                    <table class="table table-bordered align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th width="120">Qty</th>
                                <th width="120">Price</th>
                                <th width="140">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Sale.SaleItems.Count; i++)
                            {
                                <tr>
                                    <td data-label="Product">
                                        @Model.Sale.SaleItems[i].Product?.ProductName

                                        <input type="hidden" asp-for="Sale.SaleItems[i].SaleItemId" />
                                        <input type="hidden" asp-for="Sale.SaleItems[i].ProductId" />
                                    </td>

                                    <!-- ✅ FIXED QUANTITY -->
                                    <td data-label="Qty">
                                        <input asp-for="Sale.SaleItems[i].Quantity"
                                               type="number"
                                               step="0.001"
                                               min="0.001"
                                               class="form-control qty text-end"
                                               required />
                                    </td>

                                    <!-- PRICE -->
                                    <td data-label="Price">
                                        <input asp-for="Sale.SaleItems[i].Price"
                                               type="number"
                                               step="0.01"
                                               min="0"
                                               class="form-control price text-end"
                                               required />
                                    </td>

                                    <td data-label="Total">
                                        <input asp-for="Sale.SaleItems[i].Total"
                                               class="form-control row-total text-end"
                                               readonly />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <!-- END TABLE WRAP -->

                <div class="mt-4 d-flex flex-column flex-sm-row gap-2">
                    <button type="submit" class="btn btn-warning px-4">
                        Update Sale
                    </button>
                    <a asp-action="Index" class="btn btn-secondary px-4">
                        Back
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const totalAmount = document.getElementById("Sale_TotalAmount");
        const discount = document.getElementById("Sale_Discount");
        const netAmount = document.getElementById("Sale_NetAmount");

        function recalcRow(row) {
            const qty = row.querySelector(".qty");
            const price = row.querySelector(".price");
            const total = row.querySelector(".row-total");

            const q = parseFloat(qty.value) || 0;
            const p = parseFloat(price.value) || 0;

            total.value = (q * p).toFixed(2);
        }

        function recalcTotals() {
            let sum = 0;
            document.querySelectorAll(".row-total").forEach(rt => {
                sum += parseFloat(rt.value) || 0;
            });

            totalAmount.value = sum.toFixed(2);

            const disc = parseFloat(discount.value) || 0;
            netAmount.value = (sum - disc).toFixed(2);
        }

        document.querySelectorAll(".qty, .price").forEach(input => {
            input.addEventListener("input", function () {
                recalcRow(this.closest("tr"));
                recalcTotals();
            });
        });

        discount.addEventListener("input", recalcTotals);

        window.addEventListener("load", () => {
            document.querySelectorAll("tbody tr").forEach(row => recalcRow(row));
            recalcTotals();
        });
    </script>
}

<style>
    .glass-card {
        background: rgba(255,255,255,.08);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-radius: 24px;
        box-shadow: 0 10px 35px rgba(0,0,0,.08);
        padding: 10px;
    }

    .glass-section {
        background: rgba(255,255,255,.05);
        border-radius: 20px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .form-control,
    .form-select {
        background: rgba(255,255,255,.08) !important;
        border: none !important;
        border-radius: 14px;
        backdrop-filter: blur(10px);
        box-shadow: 0 4px 15px rgba(0,0,0,.05);
    }

        .form-control:focus,
        .form-select:focus {
            background: rgba(255,255,255,.15) !important;
            box-shadow: 0 0 20px rgba(59,130,246,.15);
            border: none !important;
        }

    .table {
        background: transparent !important;
    }

        .table th {
            background: rgba(255,255,255,.15);
            border: none !important;
            white-space: nowrap;
        }

        .table td {
            background: rgba(255,255,255,.04);
            border: none !important;
        }

    .btn-warning {
        border-radius: 14px;
        padding: 10px 25px;
        box-shadow: 0 6px 20px rgba(245,158,11,.25);
    }

    .btn-secondary {
        border-radius: 14px;
    }

    .page-title {
        font-size: 30px;
        font-weight: 700;
        margin-bottom: 25px;
    }

    /* ============================
           RESPONSIVE TABLE WRAP
           ============================ */
    .sale-items-wrap {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

        .sale-items-wrap table {
            min-width: 480px;
        }

    /* ============================
           RESPONSIVE BREAKPOINTS
           ============================ */
    @@media (max-width: 991.98px) {
        .page-title {
            font-size: 24px;
        }
    }

    @@media (max-width: 767.98px) {
        .container-fluid {
            padding-left: 12px;
            padding-right: 12px;
        }

        .page-title {
            font-size: 20px;
            text-align: center;
        }

        .glass-card {
            border-radius: 16px;
            padding: 4px;
        }

        .glass-section {
            padding: 14px;
        }

        h4, h5 {
            font-size: 16px;
        }

        .table th,
        .table td {
            font-size: 13px;
            padding: 8px 6px;
        }

        .mt-4 .btn {
            width: 100%;
        }
    }

    @@media (max-width: 575.98px) {
        .page-title {
            font-size: 18px;
        }

        .form-control,
        .form-select {
            font-size: 14px;
        }

        .sale-items-wrap table {
            min-width: 420px;
        }
    }
</style>
