@model KiranaStoreUI.Models.Category
@{
    ViewData["Title"] = "Delete Category";
}
<div class="form-page-wrap">

    <h2 class="mb-4 text-danger fw-bold page-title">
        <i class="bi bi-trash-fill me-2"></i> Delete Category
    </h2>

    <div class="alert alert-danger shadow-sm rounded-4 p-4">
        <h4 class="text-danger fw-bold warning-heading">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> Are you sure you want to delete this category?
        </h4>
        <hr />
        <p class="fs-5 mb-2">
            <strong><i class="bi bi-tag-fill"></i> Category Name:</strong>
            <span class="ms-2">@Model.CategoryName</span>
        </p>
    </div>

    <form asp-action="Delete" class="mt-4" id="deleteForm">
        <input type="hidden" asp-for="CategoryId" />
        <div class="form-actions">
            <button type="submit" class="btn btn-danger btn-lg shadow">
                <i class="bi bi-trash"></i> Delete
            </button>
            <a asp-action="Index" class="btn btn-secondary btn-lg shadow">
                <i class="bi bi-arrow-left-circle"></i> Cancel
            </a>
        </div>
    </form>

</div>

<style>

    /* Keeps the confirmation panel from stretching edge-to-edge on
           wide desktop monitors, while staying full-width on mobile */
    .form-page-wrap {
        max-width: 620px;
        margin: 0 auto;
    }

    .page-title {
        display: flex;
        align-items: center;
    }

    .warning-heading {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
    }

    .form-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

        .form-actions .btn {
            flex: 1 1 auto;
        }

    /* ===================================
           Responsive tweaks (mobile / tablet)
        =================================== */

    @@media (max-width: 575.98px) {

        .page-title {
            font-size: 1.35rem;
        }

        .warning-heading {
            font-size: 1.1rem;
        }

        .alert.p-4 {
            padding: 20px !important;
        }

        .fs-5 {
            font-size: 1rem !important;
        }
        /* Stack Delete/Cancel full-width so the destructive action
               isn't a tiny tap target right next to Cancel */
        .form-actions {
            flex-direction: column;
        }

            .form-actions .btn {
                width: 100%;
            }
    }
</style>

<script>
    // Extra safety on top of the warning page itself — deletion is
    // destructive and this view has no undo.
    document.getElementById("deleteForm").addEventListener("submit", function (e) {
        var confirmed = confirm("This will permanently delete this category. Continue?");
        if (!confirmed) {
            e.preventDefault();
        }
    });
</script>
