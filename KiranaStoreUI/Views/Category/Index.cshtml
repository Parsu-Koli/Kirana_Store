@model List<KiranaStoreUI.Models.Category>
@{
    ViewData["Title"] = "Categories";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

<div class="categories-header">
    <div>
        <h2 class="page-title">
            <i class="bi bi-tags-fill"></i>
            Categories
        </h2>
        <p class="page-subtitle">Manage your product categories</p>
    </div>
</div>

<div class="row g-2 g-md-3 mb-4 toolbar-row">
    <div class="col-12 col-md-4">
        <div class="search-wrap">
            <i class="bi bi-search search-icon"></i>
            <input type="text" id="searchBox"
                   placeholder="Search categories..."
                   class="form-control form-control-lg shadow-sm" />
        </div>
    </div>
    <div class="col-12 col-md-8 d-flex justify-content-md-end">
        <a asp-action="Create" class="btn btn-success btn-lg shadow add-category-btn">
            <i class="bi bi-plus-circle"></i> Add Category
        </a>
    </div>
</div>

<div class="row g-3 g-md-4" id="categoryContainer">
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <div class="col-6 col-sm-6 col-md-4 col-lg-3 category-card">
                <div class="card shadow-sm border-0 rounded-4 category-click h-100"
                     onclick="location.href='@Url.Action("All_productByID", new { id = item.CategoryId })'">
                    <div class="card-body text-center d-flex flex-column">
                        <div class="mb-2 mb-md-3">
                            <div class="category-icon-circle mx-auto">
                                <i class="bi bi-tags-fill"></i>
                            </div>
                        </div>
                        <h5 class="fw-bold category-name">@item.CategoryName</h5>
                        <p class="text-muted category-id mb-2">ID: @item.CategoryId</p>

                        <div class="mt-auto pt-2 d-flex justify-content-center gap-1 gap-md-2 action-buttons">
                            <!-- Details -->
                            <a asp-action="Details"
                               asp-route-id="@item.CategoryId"
                               class="btn btn-info btn-sm"
                               title="View details"
                               onclick="event.stopPropagation();">
                                <i class="bi bi-eye"></i>
                            </a>
                            <!-- Edit -->
                            <a asp-action="Edit"
                               asp-route-id="@item.CategoryId"
                               class="btn btn-warning btn-sm"
                               title="Edit"
                               onclick="event.stopPropagation();">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <!-- Delete -->
                            <a asp-action="Delete"
                               asp-route-id="@item.CategoryId"
                               class="btn btn-danger btn-sm"
                               title="Delete"
                               onclick="event.stopPropagation();">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="empty-state text-center">
                <i class="bi bi-inbox"></i>
                <h5 class="mt-3 mb-1">No categories yet</h5>
                <p class="text-muted mb-3">Create your first category to start organizing products.</p>
                <a asp-action="Create" class="btn btn-success">
                    <i class="bi bi-plus-circle"></i> Add Category
                </a>
            </div>
        </div>
    }
</div>

<!-- Shown by JS when a search yields no matches -->
<div class="col-12" id="noSearchResults" style="display:none;">
    <div class="empty-state text-center">
        <i class="bi bi-search"></i>
        <h5 class="mt-3 mb-1">No matching categories</h5>
        <p class="text-muted mb-0">Try a different search term.</p>
    </div>
</div>

<style>

    /* ===================================
           Header
        =================================== */

    .categories-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 22px;
    }

    .page-title {
        font-size: 1.9rem;
        font-weight: 700;
        color: #0f172a;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .page-title i {
            color: #f59e0b;
        }

    .page-subtitle {
        margin: 4px 0 0;
        color: #6c757d;
        font-size: .9rem;
    }

    /* ===================================
           Toolbar (search + add button)
        =================================== */

    .search-wrap {
        position: relative;
    }

    .search-icon {
        position: absolute;
        top: 50%;
        left: 16px;
        transform: translateY(-50%);
        color: #94a3b8;
        pointer-events: none;
    }

    #searchBox {
        border-radius: 12px;
        border: 1px solid #c9e6d2;
        padding-left: 42px;
    }

        #searchBox:focus {
            border-color: #22c55e;
            box-shadow: 0 0 0 .2rem rgba(34,197,94,.15);
        }

    .add-category-btn {
        border-radius: 12px;
        white-space: nowrap;
    }

    /* ===================================
           Category cards
        =================================== */

    .category-click {
        transition: .25s ease-in-out;
        cursor: pointer;
        background: rgba(255,255,255,.55);
    }

        .category-click:hover {
            transform: translateY(-6px);
            box-shadow: 0 15px 30px rgba(0,0,0,.15);
        }

    .category-icon-circle {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        color: #fff;
        background: linear-gradient(135deg,#f7971e,#ffd200);
        box-shadow: 0 8px 20px rgba(247,151,30,.35);
    }

    .category-name {
        font-size: 1.05rem;
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        word-break: break-word;
        min-height: 2.6em;
    }

    .category-id {
        font-size: .85rem;
    }

    .action-buttons .btn {
        border-radius: 8px;
        padding: 6px 10px;
    }

    /* ===================================
           Empty state
        =================================== */

    .empty-state {
        padding: 50px 20px;
        border-radius: 20px;
        background: rgba(255,255,255,.5);
        border: 1px dashed #cbd5e1;
    }

        .empty-state i {
            font-size: 42px;
            color: #94a3b8;
        }

    /* ===================================
           Responsive tweaks (mobile / tablet)
        =================================== */

    @@media (max-width: 767.98px) {

        .page-title {
            font-size: 1.4rem;
        }

        .page-subtitle {
            font-size: .8rem;
        }

        .add-category-btn {
            width: 100%;
            justify-content: center;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .toolbar-row {
            margin-bottom: 18px;
        }
    }

    @@media (max-width: 575.98px) {

        .category-icon-circle {
            width: 50px;
            height: 50px;
            font-size: 22px;
        }

        .category-name {
            font-size: .95rem;
            min-height: 2.4em;
        }

        .category-id {
            font-size: .78rem;
        }

        .action-buttons {
            flex-wrap: wrap;
        }

            .action-buttons .btn {
                padding: 5px 8px;
                font-size: .8rem;
            }

        .card-body {
            padding: 14px 10px;
        }
    }
</style>

<script>
    document.getElementById("searchBox").addEventListener("keyup", function () {
        var searchText = this.value.toLowerCase();
        var cards = document.querySelectorAll(".category-card");
        var visibleCount = 0;

        cards.forEach(function (card) {
            var text = card.innerText.toLowerCase();
            var isMatch = text.includes(searchText);
            card.style.display = isMatch ? "" : "none";
            if (isMatch) visibleCount++;
        });

        var noResults = document.getElementById("noSearchResults");
        if (noResults) {
            noResults.style.display = (cards.length > 0 && visibleCount === 0) ? "" : "none";
        }
    });
</script>
