@model List<KiranaStoreUI.Models.Product>
@{
    var categoryName = Model?.FirstOrDefault()?.CategoryName ?? "Category";
    var categoryId = Model?.FirstOrDefault()?.CategoryId ?? 0;
}
<div class="container my-4">
    <!-- Top Header -->
    <div class="page-header">
        <div class="header-title-block">
            <h4 class="fw-bold text-primary mb-1">
                @categoryName
            </h4>
            <small class="text-muted">
                Category ID: @categoryId
            </small>
        </div>
        <div class="header-search-block">
            <div class="search-wrap">
                <i class="bi bi-search search-icon"></i>
                <input type="text"
                       id="searchBox"
                       placeholder="Search Products..."
                       class="form-control form-control-lg shadow-sm" />
            </div>
        </div>

    </div>
    <hr />
    <h5 class="fw-bold text-success mb-3">
        Products (@Model.Count)
    </h5>
    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning text-center">
            No products found in this category.
        </div>
    }
    else
    {
        <div class="row g-3 g-md-4" id="productContainer">
            @foreach (var item in Model)
            {
                var isOutOfStock = item.QuantityInStock <= 0;
                var isLowStock = !isOutOfStock && item.QuantityInStock < 50;

                <div class="col-6 col-sm-6 col-md-4 col-lg-3 product-wrapper">
                    <a asp-controller="Product"
                       asp-action="Details"
                       asp-route-id="@item.ProductId"
                       class="text-decoration-none text-dark">
                        <div class="card product-card h-100 shadow-sm border-0 rounded-4 @(isOutOfStock ? "out-of-stock" : "")">
                            <div class="card-body p-3">

                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div class="product-icon">
                                        <i class="bi bi-box-seam"></i>
                                    </div>

                                    @if (isOutOfStock)
                                    {
                                        <span class="stock-badge stock-out">Out of Stock</span>
                                    }
                                    else if (isLowStock)
                                    {
                                        <span class="stock-badge stock-low">Low Stock</span>
                                    }
                                </div>

                                <h5 class="card-title fw-bold product-title">
                                    @item.ProductName
                                </h5>
                                <p class="small mb-2 text-secondary">
                                    Unit:
                                    <strong>@item.Unit</strong>
                                </p>
                                <p class="fw-bold text-success product-price mb-2">
                                    ₹ @item.SellingPrice
                                </p>
                                <p class="small text-secondary mb-0">
                                    Stock:
                                    <strong>@item.QuantityInStock</strong>
                                </p>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>

        <!-- Shown by JS when a search yields no matches -->
        <div class="text-center py-5" id="noSearchResults" style="display:none;">
            <i class="bi bi-search text-muted" style="font-size:36px;"></i>
            <h6 class="mt-3 mb-1">No matching products</h6>
            <p class="text-muted mb-0">Try a different search term.</p>
        </div>
    }
</div>
<style>

    /* ===================================
       Header
    =================================== */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 14px;
        margin-bottom: 16px;
    }

    .header-title-block {
        min-width: 0;
    }

    .header-search-block {
        width: 320px;
        max-width: 100%;
        flex-shrink: 0;
    }

    .search-wrap {
        position: relative;
    }

    .search-icon {
        position: absolute;
        top: 50%;
        left: 16px;
        transform: translateY(-50%);
        color: #94a3b8;
        pointer-events: none;
    }

    #searchBox {
        border-radius: 8px;
        border: 1px solid #c9e6d2;
        padding-left: 42px;
    }

        #searchBox:focus {
            border-color: #22c55e;
            box-shadow: 0 0 0 .2rem rgba(34,197,94,.15);
        }

    /* ===================================
       Product cards
    =================================== */

    .product-card {
        transition: .25s ease-in-out;
        border: 1px solid rgba(0,0,0,.08);
        background-color: white;
        cursor: pointer;
    }

        .product-card:hover {
            box-shadow: 0 10px 30px rgba(0,0,0,.18);
            transform: translateY(-8px);
        }

        .product-card.out-of-stock {
            opacity: .65;
        }

    .product-icon {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        color: #fff;
        background: linear-gradient(135deg,#4facfe,#00f2fe);
        flex-shrink: 0;
    }

    .stock-badge {
        font-size: .7rem;
        font-weight: 600;
        padding: 4px 9px;
        border-radius: 50px;
        white-space: nowrap;
    }

    .stock-out {
        background: rgba(239,68,68,.12);
        color: #dc2626;
        border: 1px solid rgba(239,68,68,.3);
    }

    .stock-low {
        background: rgba(245,158,11,.12);
        color: #d97706;
        border: 1px solid rgba(245,158,11,.3);
    }

    .product-title {
        font-size: 1.1rem;
        margin-bottom: 10px;
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        word-break: break-word;
        min-height: 2.4em;
    }

    .product-price {
        font-size: 1.05rem;
    }

    /* ===================================
       Responsive tweaks (mobile / tablet)
    =================================== */

    @@media (max-width: 767.98px) {

        .header-search-block {
            width: 100%;
        }

        .header-title-block h4 {
            font-size: 1.25rem;
        }
    }

    @@media (max-width: 575.98px) {

        .product-icon {
            width: 34px;
            height: 34px;
            font-size: 15px;
        }

        .product-title {
            font-size: .95rem;
            min-height: 2.3em;
        }

        .product-price {
            font-size: .95rem;
        }

        .stock-badge {
            font-size: .62rem;
            padding: 3px 7px;
        }

        .card-body {
            padding: 12px 10px !important;
        }

        .product-card:hover {
            transform: translateY(-4px);
        }
    }
</style>
<script>
    document.getElementById("searchBox").addEventListener("keyup", function () {
        var searchText = this.value.toLowerCase();
        var cards = document.querySelectorAll(".product-wrapper");
        var visibleCount = 0;

        cards.forEach(function (card) {
            var text = card.innerText.toLowerCase();
            var isMatch = text.includes(searchText);
            card.style.display = isMatch ? "" : "none";
            if (isMatch) visibleCount++;
        });

        var noResults = document.getElementById("noSearchResults");
        if (noResults) {
            noResults.style.display = (cards.length > 0 && visibleCount === 0) ? "" : "none";
        }
    });
</script>
