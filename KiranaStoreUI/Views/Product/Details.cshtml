@model KiranaStoreUI.Models.Product
<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-success text-white product-header">
            <h4 class="mb-0 product-name-heading">@Model.ProductName</h4>
            <span class="badge bg-light text-dark px-3 py-2">
                ID: @Model.ProductId
            </span>
        </div>
        <div class="card-body">
            <div class="row mb-2 detail-row">
                <div class="col-12 col-sm-4 fw-bold text-secondary">Category Name:</div>
                <div class="col-12 col-sm-8">@Model.CategoryName</div>
            </div>
            <div class="row mb-2 detail-row">
                <div class="col-12 col-sm-4 fw-bold text-secondary">Category ID:</div>
                <div class="col-12 col-sm-8">@Model.CategoryId</div>
            </div>
            <div class="row mb-2 detail-row">
                <div class="col-12 col-sm-4 fw-bold text-secondary">Unit:</div>
                <div class="col-12 col-sm-8">@Model.Unit</div>
            </div>
            <div class="row mb-2 detail-row">
                <div class="col-12 col-sm-4 fw-bold text-secondary">Purchase Price:</div>
                <div class="col-12 col-sm-8 text-danger fw-bold">₹ @Model.PurchasePrice</div>
            </div>
            <div class="row mb-2 detail-row">
                <div class="col-12 col-sm-4 fw-bold text-secondary">Selling Price:</div>
                <div class="col-12 col-sm-8 text-success fw-bold">₹ @Model.SellingPrice</div>
            </div>
            <div class="row mb-2 detail-row">
                <div class="col-12 col-sm-4 fw-bold text-secondary">In Stock:</div>
                <div class="col-12 col-sm-8">@Model.QuantityInStock</div>
            </div>
            <div class="row mb-2 detail-row">
                <div class="col-12 col-sm-4 fw-bold text-secondary">Description:</div>
                <div class="col-12 col-sm-8 detail-description">@Model.Description</div>
            </div>
            <div class="row mb-2 detail-row">
                <div class="col-12 col-sm-4 fw-bold text-secondary">Product Expiry Date:</div>
                <div class="col-12 col-sm-8">
                    @(Model.ExpiryDate?.ToString("dd-MM-yyyy"))
                </div>
            </div>
            <div class="row mb-4 detail-row">
                <div class="col-12 col-sm-4 fw-bold text-secondary">Barcode No:</div>
                <div class="col-12 col-sm-8">@Model.Barcode</div>
            </div>
        </div>
        <div class="card-footer bg-white product-footer">
            <div class="footer-actions-left">
                <a href="/Product/Edit/@Model.ProductId" class="btn btn-warning px-4 fw-bold">
                    <i class="bi bi-pencil-square me-1"></i> Edit
                </a>
                <a href="/Product/Delete/@Model.ProductId"
                   onclick="return confirm('Are you sure you want to delete this product?');"
                   class="btn btn-danger px-4 fw-bold ms-2">
                    <i class="bi bi-trash me-1"></i> Delete
                </a>
            </div>
            <a href="/Product/Index" class="btn btn-secondary px-4 fw-bold">
                <i class="bi bi-arrow-left-circle me-1"></i> Back
            </a>
        </div>
    </div>
</div>

<style>

    .product-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .product-name-heading {
        min-width: 0;
        word-break: break-word;
    }

    .detail-description {
        word-break: break-word;
    }

    .product-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .footer-actions-left {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    /* ===================================
           Responsive tweaks (mobile / tablet)
        =================================== */

    @@media (max-width: 575.98px) {

        .card-body {
            padding: 18px !important;
        }

        .detail-row {
            border-bottom: 1px solid rgba(0,0,0,.06);
            padding-bottom: 8px;
        }

            .detail-row .col-sm-4 {
                margin-bottom: 2px;
            }
        /* Stack Edit/Delete/Back full-width and easy to tap on phones */
        .product-footer {
            flex-direction: column;
            align-items: stretch;
        }

        .footer-actions-left {
            flex-direction: column;
        }

            .footer-actions-left .btn {
                margin-left: 0 !important;
                width: 100%;
            }

        .product-footer > a.btn {
            width: 100%;
        }
    }
</style>
